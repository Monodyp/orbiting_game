# Copy to .env.production on the VPS, chmod 600, then replace every placeholder.
# Never commit .env.production or put these server values in VITE_* variables.
NODE_ENV=production
GAME_SERVER_HOST=0.0.0.0
GAME_SERVER_PORT=2567
CLIENT_ORIGIN=https://replace-with-real-domain
VITE_GAME_SERVER_URL=wss://replace-with-real-domain
TLS_DOMAIN=replace-with-real-domain
ALLOW_INSECURE_WS=false
GUEST_SESSION_SIGNING_SECRET=replace-with-openssl-rand-hex-48-output
GUEST_SESSION_TTL_SECONDS=3600
ROOM_MAX_PLAYERS=150
DEV_BOT_COUNT=0
DEV_FORCE_ICE=false
COUNTDOWN_SECONDS=5
RECONNECT_SECONDS=25

POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32-output
DATABASE_URL=postgresql://icewater:replace-with-openssl-rand-hex-32-output@postgres:5432/icewater

# Public ingress is Nginx only. The Docker engine port 2567 and database port
# 5432 are intentionally not published on the host.
PUBLIC_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
NGINX_CONFIG=./deploy/nginx/https.conf
LETSENCRYPT_DIR=/etc/letsencrypt
ACME_WEBROOT_PATH=./.deployment/acme-webroot